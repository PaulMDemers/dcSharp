{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcsharp.local/schemas/kos-fixtures.schema.json",
  "title": "dcSharp KallistiOS Fixture Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactDirectory",
    "fixtures"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "artifactDirectory": {
      "type": "string",
      "minLength": 1
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "artifact",
        "instructions",
        "expectedStopReason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sample": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "integer",
          "minimum": 1
        },
        "traceTail": {
          "type": "integer",
          "minimum": 0
        },
        "vblankInterval": {
          "type": "integer",
          "minimum": 0
        },
        "controllerA": {
          "type": "string"
        },
        "controllerB": {
          "type": "string"
        },
        "controllers": {
          "$ref": "#/$defs/stringMap"
        },
        "controllerAScript": {
          "type": "string"
        },
        "controllerScripts": {
          "$ref": "#/$defs/stringMap"
        },
        "expectedStopReason": {
          "enum": [
            "InstructionLimit",
            "UnsupportedInstruction",
            "MemoryFault",
            "FirmwareExit",
            "ProgramExit"
          ]
        },
        "serialContains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requireVideoNonZero": {
          "type": "boolean"
        },
        "requireNoAsicPendingInterrupt": {
          "type": "boolean"
        },
        "minPvrRegisterAccesses": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minPvrTaCommandWrites": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minAicaRegisterAccesses": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minMapleTransfers": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minMapleDeviceInfoTransfers": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minMapleGetConditionTransfers": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minMapleDmaBatches": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "requireNoMapleDescriptorLimitHits": {
          "type": "boolean"
        },
        "minVblankEvents": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minHardwareAdvanceTicks": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minHardwareAdvanceBatches": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "maxHardwareAdvanceBatch": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minControllerScriptChanges": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minDeviceAccessDomains": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nonNegativeInteger"
          }
        },
        "pvrRegisters": {
          "$ref": "#/$defs/hexMap"
        },
        "aicaRegisters": {
          "$ref": "#/$defs/hexMap"
        },
        "asicPendingInterrupt": {
          "$ref": "#/$defs/asicPendingInterrupt"
        },
        "asicEventRegisters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asicEventRegister"
          }
        },
        "aicaChannels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aicaChannel"
          }
        },
        "pvrTaCommands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pvrTaCommand"
          }
        },
        "videoSamples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/videoSample"
          }
        }
      }
    },
    "asicPendingInterrupt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventCode": {
          "$ref": "#/$defs/hex32"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "levelName": {
          "enum": [
            "IRQ9",
            "IRQB",
            "IRQD"
          ]
        },
        "registerName": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "bitMask": {
          "$ref": "#/$defs/hex32"
        }
      }
    },
    "asicEventRegister": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "ack": {
          "$ref": "#/$defs/hex32"
        },
        "irq9Mask": {
          "$ref": "#/$defs/hex32"
        },
        "irqBMask": {
          "$ref": "#/$defs/hex32"
        },
        "irqDMask": {
          "$ref": "#/$defs/hex32"
        },
        "pendingIrq9": {
          "$ref": "#/$defs/hex32"
        },
        "pendingIrqB": {
          "$ref": "#/$defs/hex32"
        },
        "pendingIrqD": {
          "$ref": "#/$defs/hex32"
        }
      }
    },
    "aicaChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel"
      ],
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "control": {
          "$ref": "#/$defs/hex32"
        },
        "sampleFormat": {
          "enum": [
            "Pcm16",
            "Pcm8",
            "Adpcm",
            "AdpcmLongStream",
            "Unknown"
          ]
        },
        "sampleAddress": {
          "$ref": "#/$defs/hex32"
        },
        "loopStart": {
          "$ref": "#/$defs/hex32"
        },
        "loopEnd": {
          "$ref": "#/$defs/hex32"
        },
        "pitch": {
          "$ref": "#/$defs/hex32"
        },
        "pan": {
          "$ref": "#/$defs/byte"
        },
        "volume": {
          "$ref": "#/$defs/byte"
        },
        "active": {
          "type": "boolean"
        },
        "keyOn": {
          "type": "boolean"
        },
        "keyOnExecute": {
          "type": "boolean"
        }
      }
    },
    "pvrTaCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "minCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "videoSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "rgb565"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rgb565": {
          "$ref": "#/$defs/hex16"
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "hexMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/hex32"
      }
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "hex16": {
      "type": "string",
      "pattern": "^(0[xX])?[0-9a-fA-F]{1,4}$"
    },
    "hex32": {
      "type": "string",
      "pattern": "^(0[xX])?[0-9a-fA-F]{1,8}$"
    }
  }
}
