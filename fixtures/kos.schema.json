{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcsharp.local/schemas/kos-fixtures.schema.json",
  "title": "dcSharp KallistiOS Fixture Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactDirectory",
    "fixtures"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "artifactDirectory": {
      "type": "string",
      "minLength": 1
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "artifact",
        "instructions",
        "expectedStopReason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sample": {
          "type": "string",
          "minLength": 1
        },
        "mediaPath": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "integer",
          "minimum": 1
        },
        "traceTail": {
          "type": "integer",
          "minimum": 0
        },
        "vblankInterval": {
          "type": "integer",
          "minimum": 0
        },
        "controllerA": {
          "type": "string"
        },
        "controllerB": {
          "type": "string"
        },
        "controllers": {
          "$ref": "#/$defs/stringMap"
        },
        "controllerAScript": {
          "type": "string"
        },
        "controllerScripts": {
          "$ref": "#/$defs/stringMap"
        },
        "expectedStopReason": {
          "enum": [
            "InstructionLimit",
            "UnsupportedInstruction",
            "MemoryFault",
            "FirmwareExit",
            "ProgramExit"
          ]
        },
        "serialContains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requireVideoNonZero": {
          "type": "boolean"
        },
        "requireNoAsicPendingInterrupt": {
          "type": "boolean"
        },
        "minPvrRegisterAccesses": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minPvrTaCommandWrites": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minAicaRegisterAccesses": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minMapleTransfers": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minMapleDeviceInfoTransfers": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "minMapleGetConditionTransfers": {
          "$ref": "#/$defs/nonNegativeInteger"
